[
  {
    "name": "_README (also a valid case: null doc)",
    "note": "Shared fixtures for the ProseMirror -> plain-text codec. Rust: src-tauri/src/domain/plain_text.rs (pinned by src-tauri/tests/plain_text.rs). TypeScript: src/editor/document-codec.ts documentToPlainText (tests in src/editor/document-codec.test.ts). The two codecs MUST stay in sync: change both and this file together. Cases prefixed 'ts:' mirror the TS unit tests; expected values were produced by running the TS codec.",
    "doc": null,
    "expected": ""
  },
  {
    "name": "ts: round-trips plain text",
    "doc": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "hello world"
            }
          ]
        }
      ]
    },
    "expected": "hello world"
  },
  {
    "name": "ts: encodes empty text as an empty paragraph",
    "doc": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": []
        }
      ]
    },
    "expected": ""
  },
